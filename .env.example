# All of these are optional. Nothing here is ever sent anywhere except to Steam.

# Where the local database and cached catalog live.
CS2INV_DATA_DIR=./data

# Passphrase used to encrypt your stored Steam refresh token at rest.
# If unset, `cs2inv login` prompts for one. Leave the prompt empty to store
# the token unencrypted (file mode 0600) instead.
CS2INV_PASSPHRASE=

# Optional: your Steam Guard mobile authenticator shared secret. If set,
# two-factor codes are generated locally so `login` needs no manual code.
STEAM_SHARED_SECRET=

# Port for the local web UI (bound to 127.0.0.1 only).
CS2INV_PORT=8733

# Milliseconds to wait between storage-unit reads. Lower is faster but the
# CS2 game coordinator will throttle or drop you if you push too hard.
CS2INV_CASKET_DELAY_MS=1100
