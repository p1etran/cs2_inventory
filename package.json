{
  "name": "cs2-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "A local index of a CS2 inventory, including the contents of storage units",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "cs2inv": "dist/cli.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "login": "node dist/cli.js login",
    "sync": "node dist/cli.js sync",
    "serve": "node dist/cli.js serve",
    "protos": "node extension/scripts/gen-protos.mjs",
    "build:extension": "node extension/scripts/build.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "globaloffensive": "^3.3.0",
    "protobufjs": "7.6.6",
    "qrcode-generator": "^2.0.4",
    "steam-session": "^1.9.4",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "0.0.287",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "protobufjs-cli": "1.1.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
